<?xml version="1.0" encoding="utf-8"?>
<!-- Many public broadcasters still serve plain HTTP streams, so cleartext has to be allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
